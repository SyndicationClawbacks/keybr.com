{
  "name": "keybr-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline desktop adapter for the upstream Keybr application",
  "scripts": {
    "build:web": "node scripts/build.mjs",
    "icons": "tauri icon icon.svg --output src-tauri/icons",
