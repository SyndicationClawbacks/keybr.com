    "@tauri-apps/cli": "^2.8.4",
    "babel-loader": "^10.0.0",
    "html-webpack-plugin": "^5.6.3",
    "lightningcss": "^1.30.1"
  },
  "engines": {
    "node": ">=26.9.0"
